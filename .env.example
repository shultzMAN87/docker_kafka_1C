# Скопируйте в .env и при необходимости поменяйте значения.
# Без .env стенд тоже запустится — везде есть значения по умолчанию.

# --- Внешний доступ к брокерам ---
# Адрес, который брокеры сообщают клиентам снаружи Docker.
# localhost — если клиенты на той же машине; IP/имя хоста — если стенд
# поднят на сервере или виртуалке и подключаетесь с другой машины.
KAFKA_EXTERNAL_HOST=localhost
KAFKA_0_PORT=29092
KAFKA_1_PORT=29093
KAFKA_2_PORT=29094

# --- Брокеры ---
# Память JVM на каждый брокер
KAFKA_HEAP_OPTS=-Xms512m -Xmx512m
# Автосоздание топика при первой записи/чтении (3 партиции, RF=3)
KAFKA_AUTO_CREATE_TOPICS=true

# --- Kafka UI ---
KAFKA_UI_PORT=8080
KAFKA_CLUSTER_NAME=local
